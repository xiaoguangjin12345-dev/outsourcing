{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=OutsourcingDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "YOUR_SECRET_KEY_REPLACE_THIS_IN_PRODUCTION",
    "Issuer": "OutsourcingApi",
    "Audience": "OutsourcingClient",
    "ExpireMinutes": 1440
  },
  "UploadConfig": {
    "LocalPath": "wwwroot/uploads",
    "HostPath": "/uploads"
  },
  "EPPlus": {
    "ExcelPackage": {
      "LicenseContext": "NonCommercial"
    }
  }
}
